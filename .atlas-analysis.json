  "keyFeatures": [
    "Multi-module architecture with core, network, plugin, and server components",
    "Plugin system for extending server functionality",
    "Netty-based network protocol handling for Minecraft 1.21.1",
    "Namespace-based resource organization system",
    "Registry system for game resources (blocks, biomes, recipes, advancements)",
    "Multi-threaded server architecture with dedicated tick, socket, and message queue workers",
    "Connection state management and packet encoding/decoding",
    "Coordinate system with conversions and positioning"
  ],
  "publicApiSurface": [
    "com.wirethread.server.Server - Main server abstraction",
    "com.wirethread.plugin.Pluggable - Plugin interface",
    "com.wirethread.core.namespaces.Namespace - Resource identification",
    "com.wirethread.network.packet.Packet - Network packet interface",
    "com.wirethread.network.connection.ConnectionManager - Connection handling",
    "com.wirethread.core.registry.records.DynamicRegistries - Dynamic game registries",
    "com.wirethread.core.registry.records.StaticRegistries - Static game registries",
    "com.wirethread.core.block.BlockManager - Block management",
    "com.wirethread.core.coordinates.Position - Position handling",
    "com.wirethread.core.Tickable - Tick-based game loop interface"
  ]
